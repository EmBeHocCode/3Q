# Python cache
__pycache__/
*.py[cod]
*$py.class

# Node dependencies/cache
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime logs/cache generated while running server
logs/
*.log
*.out
*.err
*.pid
*.dump
.logs/
**/.logs/

# Local/private config
.env
.env.*
.secrets
*.local

# Private keys/certificates
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
authorized_keys

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# VM/disk images should not live in a source repository
*.qcow2
*.vdi
*.vmdk
*.iso

# Temporary files
*.tmp
*.temp
*.bak
*.swp
~$*
